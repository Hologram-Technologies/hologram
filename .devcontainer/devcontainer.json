{
  "name": "Categorical X",
  "image": "mcr.microsoft.com/devcontainers/base@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.98.1",
      "profile": "minimal"
    },
    "ghcr.io/guiyomh/features/just:0": {},
    "ghcr.io/lumenpink/devcontainer-features/wasm-pack:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.procMacro.enable": true,
        "rust-analyzer.cargo.allFeatures": true,
        "search.exclude": {
          "**/target": true
        },
        "files.watcherExclude": {
          "**/target/**": true
        }
      }
    }
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.elan/bin:/home/vscode/.cargo/bin:${containerEnv:PATH}"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends pkg-config libssl-dev && rustup toolchain install nightly-2026-09-05 --profile minimal && rustup target add wasm32-unknown-unknown wasm32-wasip1-threads thumbv7em-none-eabi && cargo install cargo-deny --version 0.20.2 --locked && cargo install cargo-nextest --version 0.9.143 --locked && cargo install cargo-public-api --version 0.52.0 --locked"
}
